  classDef ops fill:#fff7e8,stroke:#dfb66e,color:#70490e;
  class PDF,EXTRACT,CORPUS,INDEX,EMBED data;
  class USER,API,BENTO,RAG,PROMPT,SELECT,RESPONSE runtime;
  class QDRANT db;
  class LLAMA,VLLM,HF model;
  class EVALSET,RAGAS,METRICS,MLFLOW,LANGFUSE,PROM,GRAFANA,ALERT ops;
